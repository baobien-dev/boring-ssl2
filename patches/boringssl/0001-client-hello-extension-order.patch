From 08a3d420c5959abf866a56b7cb3e85dc70c3c3f3 Mon Sep 17 00:00:00 2001
From: Huynh Bao Bien <276976028+baobien-dev@users.noreply.github.com>
Date: Sat, 31 Oct 2026 18:07:52 +0700
Subject: [PATCH] Add SSL_CTX_set1_extension_order and SSL_set1_extension_order

A client names the ClientHello extension types in the order it wants
them sent. Extensions the configuration sends but the list leaves out
go first, in the built-in order, so the last named extension stays
last before the padding and pre_shared_key BoringSSL appends itself.
A set order takes precedence over SSL_CTX_set_permute_extensions, an
empty list restores the built-in order, and a list that repeats a
value or names an extension BoringSSL does not implement is rejected
with SSL_R_ERROR_ADDING_EXTENSION.
---
 include/openssl/ssl.h | 16 ++++++++++
 ssl/extensions.cc     | 71 +++++++++++++++++++++++++++++++++++++++++++
 ssl/internal.h        |  9 ++++++
 ssl/ssl_lib.cc        |  1 +
 4 files changed, 97 insertions(+)

diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index b5a149d..19d1546 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5686,6 +5686,22 @@ OPENSSL_EXPORT void SSL_CTX_set_permute_extensions(SSL_CTX *ctx, int enabled);
 // permute extensions. For now, this is only implemented for the ClientHello.
 OPENSSL_EXPORT void SSL_set_permute_extensions(SSL *ssl, int enabled);
 
+// SSL_CTX_set1_extension_order sets the order in which sockets on `ctx` send
+// ClientHello extensions. `types` lists `num_types` extension type values in
+// sending order. Extensions `ctx` sends but `types` does not name are sent
+// before them, in the built-in order. A set order takes precedence over
+// `SSL_CTX_set_permute_extensions`, and an empty `types` restores the built-in
+// order. It returns one on success and zero if `types` repeats a value or
+// names an extension this library does not implement.
+OPENSSL_EXPORT int SSL_CTX_set1_extension_order(SSL_CTX *ctx,
+                                                const uint16_t *types,
+                                                size_t num_types);
+
+// SSL_set1_extension_order behaves like `SSL_CTX_set1_extension_order` but
+// configures an individual `SSL`.
+OPENSSL_EXPORT int SSL_set1_extension_order(SSL *ssl, const uint16_t *types,
+                                            size_t num_types);
+
 // SSL_max_seal_overhead returns the maximum overhead, in bytes, of sealing a
 // record with `ssl`.
 OPENSSL_EXPORT size_t SSL_max_seal_overhead(const SSL *ssl);
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 8d0b99f..fbb8f01 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -4330,7 +4330,51 @@ static_assert(kNumExtensions <=
                   sizeof(((SSL_HANDSHAKE *)nullptr)->extensions.received) * 8,
               "too many extensions for received bitset");
 
+static const struct tls_extension *tls_extension_find(uint32_t *out_index,
+                                                      uint16_t value);
+
+// extension_order_permutation fills |out| with an index into |kExtensions| for
+// every extension, in sending order: first the extensions |order| does not
+// name, in the built-in order, then the ones it names, in the order given. It
+// returns false if |order| repeats a value or names an extension that is not
+// in |kExtensions|.
+static bool extension_order_permutation(Span<const uint16_t> order,
+                                        Array<uint8_t> *out) {
+  static_assert(kNumExtensions <= UINT8_MAX,
+                "extensions_permutation type is too small");
+  if (order.size() > kNumExtensions) {
+    return false;
+  }
+  bool named[kNumExtensions] = {};
+  Array<uint8_t> permutation;
+  if (!permutation.InitForOverwrite(kNumExtensions)) {
+    return false;
+  }
+  const size_t unnamed = kNumExtensions - order.size();
+  for (size_t i = 0; i < order.size(); i++) {
+    uint32_t index;
+    if (tls_extension_find(&index, order[i]) == nullptr || named[index]) {
+      return false;
+    }
+    named[index] = true;
+    permutation[unnamed + i] = static_cast<uint8_t>(index);
+  }
+  size_t next = 0;
+  for (size_t i = 0; i < kNumExtensions; i++) {
+    if (!named[i]) {
+      permutation[next++] = static_cast<uint8_t>(i);
+    }
+  }
+  assert(next == unnamed);
+  *out = std::move(permutation);
+  return true;
+}
+
 bool ssl_setup_extension_permutation(SSL_HANDSHAKE *hs) {
+  if (!hs->config->extension_order.empty()) {
+    return extension_order_permutation(hs->config->extension_order,
+                                       &hs->extension_permutation);
+  }
   if (!hs->config->permute_extensions) {
     return true;
   }
@@ -5342,6 +5386,33 @@ BSSL_NAMESPACE_END
 
 using namespace bssl;
 
+static int set_extension_order(Array<uint16_t> *out, const uint16_t *types,
+                               size_t num_types) {
+  Span<const uint16_t> order(types, num_types);
+  Array<uint8_t> permutation;
+  if (!extension_order_permutation(order, &permutation)) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_ERROR_ADDING_EXTENSION);
+    return 0;
+  }
+  return out->CopyFrom(order);
+}
+
+int SSL_CTX_set1_extension_order(SSL_CTX *ctx, const uint16_t *types,
+                                 size_t num_types) {
+  return set_extension_order(&FromOpaque(ctx)->extension_order, types,
+                             num_types);
+}
+
+int SSL_set1_extension_order(SSL *ssl, const uint16_t *types,
+                             size_t num_types) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return 0;
+  }
+  return set_extension_order(&ssl_impl->config->extension_order, types,
+                             num_types);
+}
+
 int SSL_parse_client_hello(const SSL *ssl, SSL_CLIENT_HELLO *out,
                            const uint8_t *in, size_t len) {
   CBS cbs = Span(in, len);
diff --git a/ssl/internal.h b/ssl/internal.h
index bff133b..9858ede 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -3469,6 +3469,11 @@ struct SSL_CONFIG {
   // SSL_GROUP_FLAG_* values ORed together.
   Array<uint32_t> supported_group_list_flags;
 
+  // extension_order, when not empty, lists ClientHello extension types in the
+  // order to send them. Extensions it does not name are sent before them, in
+  // the built-in order.
+  Array<uint16_t> extension_order;
+
   // For a client, this may contain a subsequence of the group IDs in
   // `suppported_group_list`, which gives the groups for which key shares should
   // be sent in the client's key_share extension. This is non-nullopt iff
@@ -4120,6 +4125,10 @@ class SSLContext : public ssl_ctx_st, public RefCounted<SSLContext> {
   Array<uint16_t> supported_group_list;
   Array<uint32_t> supported_group_list_flags;
 
+  // The ClientHello extension order inherited by SSL structure, see
+  // SSL_CONFIG::extension_order.
+  Array<uint16_t> extension_order;
+
   // channel_id_private is the client's Channel ID private key, or null if
   // Channel ID should not be offered on this connection.
   UniquePtr<EVP_PKEY> channel_id_private;
diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index f28a49b..56b6197 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -518,6 +518,7 @@ SSL *SSL_new(SSL_CTX *ctx) {
           ctx_impl->supported_group_list) ||
       !ssl->config->supported_group_list_flags.CopyFrom(
           ctx_impl->supported_group_list_flags) ||
+      !ssl->config->extension_order.CopyFrom(ctx_impl->extension_order) ||
       !ssl->config->alpn_client_proto_list.CopyFrom(
           ctx_impl->alpn_client_proto_list) ||
       !ssl->config->verify_sigalgs.CopyFrom(ctx_impl->verify_sigalgs) ||
-- 
